// ==============================================================================
// IMPORTANT: JSON DOES NOT SUPPORT COMMENTS!
// YOU MUST DELETE ALL COMMENT LINES (ALL LINES STARTING WITH //) BEFORE SAVING
// THIS FILE AS .bob/mcp.json.
// If any comments remain in .bob/mcp.json, JSON parsing will fail and Bob
// will not load the MCP server.
//
// Authentication note:
// Use CONCERT_CPD_API_KEY (recommended for IdP/SSO) OR swap it for
// CONCERT_CPD_PASSWORD if using a local CPD account. Only one is required.
// ==============================================================================
{
  "mcpServers": {
    "concert-operate": {
      "command": "node",
      "args": ["build/index.js"],
      "env": {
        "CONCERT_BASE_URL": "https://your-instance.example.com",
        "CONCERT_CPD_USER": "cpadmin",
        "CONCERT_CPD_API_KEY": "your-cpd-api-key"
      }
    }
  }
}
